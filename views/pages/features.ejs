<% layout('layouts/main') %>

<section class="relative overflow-clip">
  <div class="sky absolute inset-0" aria-hidden="true"></div>
  <div class="cloud top-[260px] left-[3%] h-[110px] w-[480px] opacity-90" aria-hidden="true"></div>
  <div class="cloud top-[230px] right-[5%] h-[100px] w-[420px] opacity-80 [animation-duration:28s]" aria-hidden="true"></div>
  <%- include('../partials/header', { currentPage: 'features' }) %>
  <div class="relative px-5 pt-14 pb-28 text-center d:px-10 d:pt-[72px] d:pb-[150px]">
    <span class="pill in" style="--d:.1s">Features</span>
    <h1 class="serif in mx-auto mt-7 max-w-[900px] text-[54px] leading-[.98] d:text-[96px]" style="--d:.2s">Small tools, <i>carefully</i> made</h1>
    <p class="in mx-auto mt-6 max-w-[540px] text-[17px] leading-relaxed text-muted d:text-[19px]" style="--d:.35s">Everything MyDrive does, and does without fuss. Scroll for a closer look at each one.</p>
    <div class="in mt-8 flex justify-center gap-3" style="--d:.5s">
      <a class="btn btn-dark" href="/user/register">Start for free</a>
      <a class="btn btn-light" href="/user/login">Sign in</a>
    </div>
  </div>
</section>

<%
  const features = [
    { n: '01', t: 'Batch uploads', d: 'Drop up to ten files at once. Each one streams to storage with its own progress bar, speed and time left, and you can cancel any of them.', v: 'upload' },
    { n: '02', t: 'Sort and find', d: 'Sort by newest, oldest, name or size, page through big folders, and filter what is on screen as you type.', v: 'sort' },
    { n: '03', t: 'Share two ways', d: 'Send a file straight to another MyDrive username, or generate a link anyone can open. Copy it in one click.', v: 'share' },
    { n: '04', t: 'Rename and inspect', d: 'Rename a file without losing its extension, and check its size and upload date in a clean details panel.', v: 'details' },
    { n: '05', t: 'Recycle bin', d: 'Deleted files wait in the bin. Restore them or remove them forever, one by one or all selected at once.', v: 'trash' },
    { n: '06', t: 'Account security', d: 'Hashed passwords, short-lived sessions, rate-limited sign-in and strict security headers on every response.', v: 'security' }
  ];
%>
<section class="grid grid-cols-1 gap-12 px-5 py-20 d:grid-cols-[1fr_1.25fr] d:gap-20 d:px-16 d:py-[120px]">
  <div>
    <div class="d:sticky d:top-16">
      <span class="text-sm text-muted">What's inside</span>
      <h2 class="serif sv mt-3 text-[44px] leading-none d:text-[68px]">Built for the <i>everyday</i> stuff</h2>
      <ol class="mt-10 hidden list-none gap-1 p-0 d:grid">
        <% features.forEach(function (f) { %><li><a href="#f-<%= f.n %>" class="flex items-baseline gap-4 border-t border-line py-3.5 text-lg text-muted no-underline transition hover:text-ink"><span class="text-xs text-faint"><%= f.n %></span><%= f.t %></a></li><% }) %>
      </ol>
    </div>
  </div>
  <div class="grid gap-6">
    <% features.forEach(function (f) { %>
    <article id="f-<%= f.n %>" class="card sv scroll-mt-24 p-7 d:p-10">
      <div class="text-[13px] text-faint"><%= f.n %></div>
      <h3 class="serif mt-2 text-[34px] leading-none d:text-[40px]"><%= f.t %></h3>
      <p class="mt-3 text-base leading-relaxed text-muted"><%= f.d %></p>
      <div class="mt-7" aria-hidden="true">
        <% if (f.v === 'upload') { %>
          <div class="grid gap-3 rounded-2xl border border-line-soft bg-[#f7f9f6] p-4">
            <% [['lecture-notes.pdf','82%','bg-forest'],['trip-photo.jpg','54%','bg-amber'],['backup.zip','23%','bg-slate']].forEach(function (u) { %>
            <div class="rounded-xl bg-white p-3 text-[13px]"><div class="flex justify-between"><span class="font-medium"><%= u[0] %></span><span class="text-faint"><%= u[1] %></span></div><div class="mt-2 h-1 overflow-hidden rounded-full bg-line-soft"><div class="grow-w h-full rounded-full <%= u[2] %>" style="width: <%= u[1] %>"></div></div></div>
            <% }) %>
          </div>
        <% } else if (f.v === 'sort') { %>
          <div class="rounded-2xl border border-line-soft p-4">
            <div class="flex flex-wrap gap-2 text-[13px]"><span class="rounded-full bg-ink px-3 py-1.5 text-white">Newest first</span><span class="rounded-full border border-line px-3 py-1.5">Oldest</span><span class="rounded-full border border-line px-3 py-1.5">Name A–Z</span><span class="rounded-full border border-line px-3 py-1.5">Largest</span></div>
            <div class="mt-4 flex h-11 items-center gap-2 rounded-xl bg-[#f1f3f0] px-3.5 text-sm"><%- include('../partials/icon', {n:'search', s:15, w:2}) %>the<span class="live -ml-1.5 inline-block h-4 w-px bg-ink"></span></div>
            <div class="mt-3 grid gap-1.5 text-[13.5px]"><span class="rounded-lg bg-sage/60 px-3 py-2"><b class="font-semibold">the</b>sis-final.pdf</span><span class="rounded-lg px-3 py-2"><b class="font-semibold">the</b>me-sketches.png</span></div>
          </div>
        <% } else if (f.v === 'share') { %>
          <div class="grid gap-3 rounded-2xl bg-mist p-4 text-[13px]">
            <div class="flex items-center gap-3 rounded-xl bg-white p-3"><span class="inline-flex size-8 items-center justify-center rounded-full bg-sage text-xs font-semibold text-forest-deep">SA</span><span class="flex-1">Shared with <b class="font-semibold">sara_k</b></span><span class="text-forest">Sent</span></div>
            <div class="flex items-center gap-2.5 rounded-xl bg-white py-2.5 pr-2.5 pl-3.5"><span class="flex-1 truncate text-muted">mydrive.app/share/k9x2f1…</span><span class="inline-flex h-[30px] items-center rounded-full bg-ink px-3 text-white">Copy</span></div>
          </div>
        <% } else if (f.v === 'details') { %>
          <dl class="m-0 grid overflow-hidden rounded-2xl border border-line-soft text-[13.5px]">
            <div class="flex justify-between px-4 py-3"><dt class="text-faint">Name</dt><dd class="m-0 font-medium">final-thesis<span class="text-faint">.pdf</span></dd></div>
            <div class="flex justify-between border-t border-line-soft px-4 py-3"><dt class="text-faint">Size</dt><dd class="m-0">812 KB</dd></div>
            <div class="flex justify-between border-t border-line-soft px-4 py-3"><dt class="text-faint">Uploaded</dt><dd class="m-0">Oct 21, 2026</dd></div>
          </dl>
        <% } else if (f.v === 'trash') { %>
          <div class="grid gap-2 rounded-2xl border border-line-soft p-3 text-[13.5px]">
            <div class="flex items-center gap-3 rounded-xl bg-[#f7f9f6] px-3 py-2.5"><span class="size-4 rounded border border-line bg-ink"></span><span class="flex-1">old-draft.docx</span><span class="rounded-full bg-sage px-2.5 py-1 text-xs text-forest-deep">Restore</span></div>
            <div class="flex items-center gap-3 rounded-xl px-3 py-2.5"><span class="size-4 rounded border border-line"></span><span class="flex-1">screenshot-12.png</span><span class="rounded-full bg-rust-soft px-2.5 py-1 text-xs text-rust">Delete forever</span></div>
          </div>
        <% } else { %>
          <div class="grid gap-2 text-[13.5px]">
            <% ['Password hashed with bcrypt','Session expires after an hour','Five sign-in attempts, then a pause'].forEach(function (s) { %>
            <div class="flex items-center gap-3 rounded-xl bg-mist px-4 py-3"><span class="text-forest"><%- include('../partials/icon', {n:'check', s:16, w:2.2}) %></span><%= s %></div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </article>
    <% }) %>
  </div>
</section>

<section class="px-5 pb-24 d:px-16 d:pb-[120px]">
  <h2 class="serif sv mb-12 text-center text-[44px] leading-none d:text-[60px]">How it <i>works</i></h2>
  <div class="grid grid-cols-1 gap-10 d:grid-cols-4">
    <% [['01','Sign up','A username, an email and a password.'],['02','Upload','Choose or drop up to ten files.'],['03','Organise','Sort, rename and tidy up.'],['04','Share','Send to a user or copy a link.']].forEach(function (s) { %>
    <div class="sv"><div class="ln h-px bg-ink"></div><div class="serif mt-5 text-[40px]"><%= s[0] %></div><h3 class="mt-2 mb-0 text-lg font-semibold"><%= s[1] %></h3><p class="mt-1.5 text-[15px] text-muted"><%= s[2] %></p></div>
    <% }) %>
  </div>
</section>

<section class="px-5 pb-24 d:px-10">
  <div class="sky relative min-h-[460px] overflow-hidden rounded-[30px] text-center">
    <div class="rise absolute inset-x-0 bottom-0 h-[320px]" aria-hidden="true"><%- include('../partials/landscape') %></div>
    <div class="sv relative px-6 pt-20">
      <h2 class="serif m-0 text-[46px] leading-none d:text-[72px]">Try it with <i>your</i> files</h2>
      <p class="mt-4 mb-8 text-lg text-muted">500 MB free. No card needed.</p>
      <a class="btn btn-dark" href="/user/register">Create account</a>
    </div>
  </div>
</section>
