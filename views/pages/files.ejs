<% layout('layouts/app') %>
<% block('nav', 'files') %>
<%
  const fmt = (b) => b < 1024 ? b + ' B' : b < 1048576 ? (b / 1024).toFixed(1) + ' KB' : b < 1073741824 ? (b / 1048576).toFixed(1) + ' MB' : (b / 1073741824).toFixed(2) + ' GB';
  const date = (d) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  const trash = Array.isArray(typeof trashedFiles !== 'undefined' ? trashedFiles : null) ? trashedFiles : [];
  const pg = typeof pagination !== 'undefined' ? pagination : { totalPages: 1, currentPage: 1 };
%>

<nav class="in text-sm text-faint" style="--d:.05s" aria-label="Breadcrumb"><a href="/dashboard" class="text-faint no-underline hover:text-ink">Home</a> <span aria-hidden="true">/</span> <span class="text-ink">My files</span></nav>
<div class="in mt-2 flex flex-wrap items-end justify-between gap-4" style="--d:.1s">
  <div>
    <h1 class="serif m-0 text-[44px] leading-none d:text-[64px]">My <i>files</i></h1>
    <p class="mt-3 mb-0 text-muted"><%= (pg.totalFiles || fileCount || 0) %> file<%= (pg.totalFiles || fileCount) === 1 ? '' : 's' %> · <%= fmt(Number(typeof storageBytes !== 'undefined' ? storageBytes : 0) || 0) %> used</p>
  </div>
  <div class="flex flex-wrap items-center gap-2.5">
    <label for="sortSelect" class="sr-only">Sort files</label>
    <select id="sortSelect" class="field h-11 w-auto cursor-pointer rounded-full pr-10 text-sm">
      <option value="date" <%= currentSort === 'date' ? 'selected' : '' %>>Newest first</option>
      <option value="oldest" <%= currentSort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
      <option value="name" <%= currentSort === 'name' ? 'selected' : '' %>>Name (A–Z)</option>
      <option value="size" <%= currentSort === 'size' ? 'selected' : '' %>>Largest first</option>
    </select>
    <button type="button" data-open-upload class="btn btn-dark btn-sm h-11"><%- include('../partials/icon', {n:'upload', s:15, w:2}) %>Upload</button>
  </div>
</div>

<button type="button" data-open-upload class="in mt-7 flex w-full cursor-pointer items-center justify-center gap-3 rounded-[18px] border-[1.5px] border-dashed border-[#cfd5cd] bg-[#f7f9f6] px-5 py-5 text-sm text-muted transition hover:border-ink hover:text-ink" style="--d:.15s">
  <span class="inline-flex size-9 items-center justify-center rounded-xl bg-white text-forest shadow-sm"><%- include('../partials/icon', {n:'upload', s:17}) %></span>
  Drop files in the upload window, or click to choose
</button>

<section class="in mt-6" style="--d:.2s" aria-label="Your files">
  <% if (files && files.length) { %>
  <div class="overflow-hidden rounded-[18px] border border-line-soft bg-white">
    <div class="hidden grid-cols-[minmax(0,2.4fr)_1fr_1.2fr_auto] gap-4 border-b border-line-soft bg-[#fafbf9] px-5 py-3 text-xs text-faint d:grid"><span>Name</span><span>Size</span><span>Uploaded</span><span class="w-[200px] text-right">Actions</span></div>
    <% files.forEach(function (file) { %>
    <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 border-t border-line-soft px-4 py-3 first:border-t-0 transition hover:bg-[#fafbf9] d:grid-cols-[minmax(0,2.4fr)_1fr_1.2fr_auto] d:px-5" data-name="<%= file.originalName %>">
      <div class="flex min-w-0 items-center gap-3">
        <%- include('../partials/file-badge', { name: file.originalName, mime: file.mimeType }) %>
        <div class="min-w-0"><div class="truncate text-sm font-medium" title="<%= file.originalName %>"><%= file.originalName %></div><div class="text-xs text-faint d:hidden"><%= fmt(file.fileSize) %> · <%= date(file.uploadedAt) %></div></div>
      </div>
      <span class="hidden text-sm text-muted d:block"><%= fmt(file.fileSize) %></span>
      <span class="hidden text-sm text-muted d:block"><%= new Date(file.uploadedAt).toLocaleString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
      <div class="col-span-2 -ml-2 flex items-center gap-0.5 d:col-span-1 d:ml-0 d:justify-end">
        <button type="button" class="file-action-btn icon-btn" data-action="details" data-file-id="<%= file._id %>" data-file-name="<%= file.originalName %>" data-file-size="<%= file.fileSize %>" data-upload-date="<%= new Date(file.uploadedAt).toISOString() %>" aria-label="Details for <%= file.originalName %>" title="Details"><%- include('../partials/icon', {n:'info'}) %></button>
        <a href="/files/<%= file._id %>" class="icon-btn" aria-label="Download <%= file.originalName %>" title="Download"><%- include('../partials/icon', {n:'download'}) %></a>
        <button type="button" class="file-action-btn icon-btn" data-action="share" data-file-id="<%= file._id %>" aria-label="Share <%= file.originalName %>" title="Share"><%- include('../partials/icon', {n:'share'}) %></button>
        <button type="button" class="file-action-btn icon-btn" data-action="rename" data-file-id="<%= file._id %>" data-file-name="<%= file.originalName %>" aria-label="Rename <%= file.originalName %>" title="Rename"><%- include('../partials/icon', {n:'edit'}) %></button>
        <button type="button" class="file-action-btn icon-btn hover:!text-rust" data-action="delete" data-file-id="<%= file._id %>" aria-label="Delete <%= file.originalName %>" title="Move to recycle bin"><%- include('../partials/icon', {n:'trash'}) %></button>
      </div>
    </div>
    <% }) %>
  </div>

  <% if (pg.totalPages > 1) { %>
  <nav class="mt-5 flex flex-wrap items-center justify-between gap-3 text-sm" aria-label="Pagination">
    <span class="text-faint">Page <%= pg.currentPage %> of <%= pg.totalPages %></span>
    <div class="flex flex-wrap items-center gap-1.5">
      <% if (pg.hasPrevPage) { %><a class="btn btn-light btn-sm" href="/files?sort=<%= currentSort %>&page=<%= pg.currentPage - 1 %>">← Previous</a><% } %>
      <% for (let i = 1; i <= pg.totalPages; i++) { %>
        <% if (i === pg.currentPage) { %><span class="inline-flex size-10 items-center justify-center rounded-full bg-ink font-medium text-white" aria-current="page"><%= i %></span>
        <% } else { %><a class="inline-flex size-10 items-center justify-center rounded-full text-ink no-underline hover:bg-white" href="/files?sort=<%= currentSort %>&page=<%= i %>"><%= i %></a><% } %>
      <% } %>
      <% if (pg.hasNextPage) { %><a class="btn btn-light btn-sm" href="/files?sort=<%= currentSort %>&page=<%= pg.currentPage + 1 %>">Next →</a><% } %>
    </div>
  </nav>
  <% } %>
  <% } else { %>
  <div class="flex flex-col items-center gap-3 rounded-[18px] border border-line-soft bg-white px-6 py-14 text-center">
    <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-sage text-forest-deep"><%- include('../partials/icon', {n:'folder', s:22}) %></span>
    <span class="font-medium">No files uploaded yet</span>
    <button type="button" data-open-upload class="btn btn-dark btn-sm mt-1">Upload your first file</button>
  </div>
  <% } %>
</section>

<section id="trash" class="mt-12 scroll-mt-24" aria-labelledby="trashTitle">
  <div class="flex flex-wrap items-end justify-between gap-2">
    <h2 id="trashTitle" class="serif m-0 text-[36px] leading-none">Recycle <i>bin</i></h2>
    <p class="m-0 text-sm text-muted">Files stay here until you delete them for good.</p>
  </div>
  <% if (trash.length) { %>
  <div class="mt-4 flex flex-wrap items-center gap-3 rounded-2xl bg-mist px-4 py-3">
    <label class="flex cursor-pointer items-center gap-2.5 text-sm font-medium"><input type="checkbox" id="selectAllTrash" class="size-[18px] accent-ink"> Select all</label>
    <span id="trashSelectedCount" class="ml-auto text-sm text-muted">0 selected</span>
    <button type="button" id="bulkRestoreBtn" class="trash-action-btn btn btn-light btn-sm h-9" data-trash-action="bulkRestore" style="display: none;"><%- include('../partials/icon', {n:'restore', s:14}) %>Restore selected</button>
    <button type="button" id="bulkDeleteBtn" class="trash-action-btn btn btn-danger btn-sm h-9" data-trash-action="bulkDelete" style="display: none;"><%- include('../partials/icon', {n:'trash', s:14}) %>Delete selected</button>
  </div>
  <div class="mt-3 overflow-hidden rounded-[18px] border border-line-soft bg-white">
    <% trash.forEach(function (file) { %>
    <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3 gap-y-2 border-t border-line-soft px-4 py-3 first:border-t-0 d:grid-cols-[auto_minmax(0,2fr)_1fr_1.2fr_auto] d:px-5" data-name="<%= file.originalName %>">
      <input type="checkbox" class="trashCheckbox size-[18px] accent-ink" value="<%= file._id %>" aria-label="Select <%= file.originalName %>">
      <div class="flex min-w-0 items-center gap-3 opacity-75">
        <%- include('../partials/file-badge', { name: file.originalName, mime: file.mimeType }) %>
        <span class="truncate text-sm font-medium" title="<%= file.originalName %>"><%= file.originalName %></span>
      </div>
      <span class="hidden text-sm text-muted d:block"><%= fmt(file.fileSize) %></span>
      <span class="hidden text-sm text-muted d:block">Deleted <%= date(file.deletedAt || file.updatedAt) %></span>
      <div class="col-span-2 flex justify-end gap-2 d:col-span-1">
        <button type="button" class="trash-action-btn btn btn-light btn-sm h-9" data-trash-action="restore" data-file-id="<%= file._id %>"><%- include('../partials/icon', {n:'restore', s:14}) %>Restore</button>
        <button type="button" class="trash-action-btn btn btn-danger btn-sm h-9" data-trash-action="deleteForever" data-file-id="<%= file._id %>">Delete forever</button>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <p class="mt-4 flex items-center gap-2 text-sm text-muted"><span class="text-forest"><%- include('../partials/icon', {n:'check', s:16, w:2.2}) %></span>The recycle bin is empty.</p>
  <% } %>
</section>

<%- include('../partials/file-modals') %>
<script src="/js/file-operations.js"></script>
<script src="/js/file-actions.js"></script>
<script src="/js/file-page-events.js"></script>
