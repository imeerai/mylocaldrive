<% layout('layouts/auth') %>
<%
  const errorText = (typeof error !== 'undefined' && error) ? error : '';
  const errLower = errorText.toLowerCase();
  const usernameErr = errorText && errLower.includes('username') && (errLower.includes('exist') || errLower.includes('invalid') || errLower.includes('require'));
  const emailErr = errorText && errLower.includes('email') && (errLower.includes('exist') || errLower.includes('invalid') || errLower.includes('require'));
  const generalError = errorText && !usernameErr && !emailErr;
%>
<main class="grid min-h-screen grid-cols-1 gap-4 p-3 d:grid-cols-2 d:p-4">
  <%- include('../partials/auth-scene', { tagline: 'Start with <i>500 MB</i>, and a lot less clutter.', cards: [['University','64%','bg-sage text-forest-deep','folder'],['Photos','40%','bg-amber-soft text-amber','image'],['Projects','22%','bg-slate-soft text-slate','folder']] }) %>
  <div class="flex flex-col px-3 py-5 d:order-first d:hidden"><%- include('../partials/logo') %></div>
  <div class="flex flex-col px-3 pb-5 d:px-14 d:py-8">
    <div class="hidden justify-end d:flex"><%- include('../partials/logo') %></div>
    <div class="mx-auto flex w-full max-w-[440px] flex-1 flex-col justify-center py-10">
      <span class="pill in w-fit" style="--d:.05s"><span class="live size-[7px] rounded-full bg-forest"></span>500 MB free</span>
      <h1 class="serif in mt-5 mb-0 text-[52px] leading-none d:text-[64px]" style="--d:.1s">Create your <i>drive</i></h1>
      <p class="in mt-3 text-muted" style="--d:.2s">It takes less than a minute.</p>

      <% if (generalError) { %>
        <div class="mt-6 flex items-center gap-2.5 rounded-2xl bg-rust-soft px-4 py-3 text-sm text-rust" role="alert"><%- include('../partials/icon', {n:'info', s:16, w:2}) %><%= errorText %></div>
      <% } %>

      <form id="registerForm" class="in mt-8 grid gap-5" style="--d:.3s" action="/user/register" method="POST" novalidate>
        <div>
          <label for="username" class="field-label">Username</label>
          <input type="text" id="username" name="username" class="field <%= usernameErr ? 'input-error' : '' %>" placeholder="3–20 letters, numbers or _" autocomplete="username" autocapitalize="none" required>
          <span class="error-message field-error" id="usernameError"><%= usernameErr ? errorText : '' %></span>
        </div>
        <div>
          <label for="email" class="field-label">Email</label>
          <div class="relative">
            <input type="email" id="email" name="email" class="field pr-10 <%= emailErr ? 'input-error' : '' %>" placeholder="name@example.com" autocomplete="email" required>
            <span id="emailCheckIcon" class="absolute top-1/2 right-4 -translate-y-1/2" style="display: none;"></span>
          </div>
          <span class="error-message field-error" id="emailError"><%= emailErr ? errorText : '' %></span>
        </div>
        <div>
          <label for="password" class="field-label">Password</label>
          <div class="relative">
            <input type="password" id="password" name="password" class="field pr-12" placeholder="At least 8 characters" autocomplete="new-password" required>
            <button type="button" class="icon-btn absolute top-1 right-1" data-toggle-password="password" aria-label="Show password" aria-pressed="false"><%- include('../partials/icon', {n:'eye', s:18}) %></button>
          </div>
          <div class="mt-3 grid grid-cols-4 gap-1.5" aria-hidden="true">
            <span data-meter class="h-1 rounded-full bg-line-soft transition-colors"></span><span data-meter class="h-1 rounded-full bg-line-soft transition-colors"></span><span data-meter class="h-1 rounded-full bg-line-soft transition-colors"></span><span data-meter class="h-1 rounded-full bg-line-soft transition-colors"></span>
          </div>
          <p id="pwStrength" class="mt-2 mb-0 text-xs text-faint">Use upper and lower case letters and a number.</p>
          <span class="error-message field-error" id="passwordError"></span>
        </div>
        <button type="submit" class="btn btn-dark w-full">Create account</button>
      </form>
      <p class="in mt-7 text-center text-sm text-muted" style="--d:.4s">Already have an account? <a href="/user/login" class="font-medium text-ink underline decoration-line underline-offset-4 hover:decoration-ink">Sign in</a></p>
    </div>
  </div>
</main>
<script src="/js/validation.js"></script>
<script src="/js/register.js"></script>
<script>
  (() => {
    const pw = document.getElementById('password');
    const bars = document.querySelectorAll('[data-meter]');
    const label = document.getElementById('pwStrength');
    const names = ['Use upper and lower case letters and a number.', 'Weak', 'Fair', 'Good', 'Strong'];
    const colors = ['bg-rust', 'bg-amber', 'bg-forest', 'bg-forest'];
    pw.addEventListener('input', () => {
      const v = pw.value;
      const score = !v ? 0 : [v.length >= 8, /[A-Z]/.test(v) && /[a-z]/.test(v), /\d/.test(v), v.length >= 12 || /[^A-Za-z0-9]/.test(v)].filter(Boolean).length;
      bars.forEach((b, i) => { b.className = 'h-1 rounded-full transition-colors ' + (i < score ? colors[score - 1] : 'bg-line-soft'); });
      label.textContent = names[score];
    });
  })();
</script>
