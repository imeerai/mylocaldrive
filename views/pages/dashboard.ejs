<% layout('layouts/app') %>
<% block('nav', 'dashboard') %>
<%
  const fmt = (b) => b < 1024 ? b + ' B' : b < 1048576 ? (b / 1024).toFixed(1) + ' KB' : b < 1073741824 ? (b / 1048576).toFixed(1) + ' MB' : (b / 1073741824).toFixed(2) + ' GB';
  const bytes = typeof storageBytes !== 'undefined' ? Number(storageBytes) || 0 : 0;
  const usedMB = bytes / 1048576;
  const pct = Math.min(100, (usedMB / 500) * 100);
  const first = (user && (user.firstName || user.username)) || 'there';
  const types = typeof byType !== 'undefined' && byType ? byType : [];
  const typeTotal = types.reduce((s, t) => s + t.bytes, 0) || 1;
  const shared = Array.isArray(typeof sharedFiles !== 'undefined' ? sharedFiles : null) ? sharedFiles : [];
  const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
%>

<div class="in text-sm text-faint" style="--d:.05s"><%= today %></div>
<h1 class="serif in mt-1 mb-0 text-[44px] leading-none d:text-[64px]" style="--d:.1s">Welcome back, <i><%= first %></i></h1>
<p class="in mt-3 text-[16px] text-muted" style="--d:.15s"><%= usedMB.toFixed(1) %> MB of 500 MB in use across <%= fileCount || 0 %> file<%= fileCount === 1 ? '' : 's' %>.</p>

<div class="in mt-6 flex flex-wrap gap-2.5" style="--d:.2s">
  <button type="button" data-open-upload class="btn btn-dark btn-sm h-11"><%- include('../partials/icon', {n:'upload', s:15, w:2}) %>Upload files</button>
  <a href="/files" class="btn btn-light btn-sm h-11"><%- include('../partials/icon', {n:'folder', s:15}) %>Browse files</a>
  <a href="/profile" class="btn btn-light btn-sm h-11"><%- include('../partials/icon', {n:'user', s:15}) %>Profile</a>
  <button type="button" id="dashboardRefreshBtn" class="btn btn-light btn-sm h-11" data-reload><%- include('../partials/icon', {n:'restore', s:15}) %>Refresh</button>
</div>

<div class="mt-8 grid grid-cols-1 gap-4 d:grid-cols-[1.45fr_1fr]">
  <section class="card in p-6 d:p-7" style="--d:.25s" aria-labelledby="storageTitle">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="storageTitle" class="m-0 text-sm font-medium text-muted">Storage used</h2>
        <div class="mt-2 text-[32px] font-semibold tracking-[-1px] d:text-[40px]"><%= usedMB.toFixed(1) %> <span class="text-sm font-medium whitespace-nowrap text-faint d:text-base">MB of 500 MB</span></div>
        <div class="mt-1 text-[13px] text-forest"><%= Math.max(0, 500 - usedMB).toFixed(1) %> MB still free</div>
      </div>
      <svg width="88" height="88" viewBox="0 0 120 120" class="shrink-0" aria-hidden="true"><circle cx="60" cy="60" r="48" fill="none" stroke="#eef0ec" stroke-width="12"/><circle cx="60" cy="60" r="48" fill="none" stroke="#3f7d5a" stroke-width="12" stroke-linecap="round" stroke-dasharray="302" stroke-dashoffset="<%= (302 - (302 * pct) / 100).toFixed(1) %>" transform="rotate(-90 60 60)"/><text x="60" y="68" text-anchor="middle" font-family="Instrument Serif, serif" font-size="28" fill="#171b18"><%= Math.round(pct) %>%</text></svg>
    </div>
    <div class="mt-6 h-2.5 overflow-hidden rounded-full bg-line-soft" role="progressbar" aria-valuemin="0" aria-valuemax="500" aria-valuenow="<%= usedMB.toFixed(1) %>" aria-label="Storage used"><div class="grow-w h-full rounded-full bg-ink" style="width: <%= pct.toFixed(1) %>%"></div></div>
    <div class="mt-2 flex justify-between text-xs text-faint"><span>0 MB</span><span>500 MB</span></div>
  </section>

  <section class="card in p-6 d:p-7" style="--d:.3s" aria-labelledby="typeTitle">
    <h2 id="typeTitle" class="m-0 text-sm font-medium text-muted">By type</h2>
    <% if (types.length) { %>
      <div class="mt-5 flex h-2.5 gap-1 overflow-hidden rounded-full" aria-hidden="true">
        <% types.forEach(function (t) { %><span class="grow-w h-full <%= t.color %>" style="width: <%= Math.max(2, (t.bytes / typeTotal) * 100).toFixed(1) %>%"></span><% }) %>
      </div>
      <ul class="mt-5 grid list-none gap-3 p-0 text-sm">
        <% types.forEach(function (t) { %>
        <li class="flex items-center gap-2.5"><span class="size-2.5 rounded-[3px] <%= t.color %>"></span><span class="flex-1"><%= t.label %></span><span class="text-faint"><%= t.count %> file<%= t.count === 1 ? '' : 's' %></span><span class="w-20 text-right font-semibold"><%= fmt(t.bytes) %></span></li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="mt-5 text-sm text-muted">Nothing stored yet. Your first upload will show up here.</p>
    <% } %>
  </section>
</div>

<section class="mt-10" aria-labelledby="recentTitle">
  <div class="flex items-end justify-between gap-4">
    <h2 id="recentTitle" class="m-0 text-lg font-semibold">Recent files</h2>
    <a href="/files" class="text-sm text-muted no-underline hover:text-ink">View all →</a>
  </div>
  <% if (files && files.length) { %>
  <div class="mt-4 overflow-hidden rounded-[18px] border border-line-soft bg-white">
    <div class="hidden grid-cols-[minmax(0,2.4fr)_1fr_1fr_auto] gap-4 border-b border-line-soft bg-[#fafbf9] px-5 py-3 text-xs text-faint d:grid"><span>Name</span><span>Size</span><span>Uploaded</span><span class="w-[200px] text-right">Actions</span></div>
    <% files.forEach(function (file) { %>
    <div class="group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 border-t border-line-soft px-4 py-3 first:border-t-0 transition hover:bg-[#fafbf9] d:grid-cols-[minmax(0,2.4fr)_1fr_1fr_auto] d:px-5" data-name="<%= file.originalName %>">
      <div class="flex min-w-0 items-center gap-3">
        <%- include('../partials/file-badge', { name: file.originalName, mime: file.mimeType }) %>
        <div class="min-w-0"><div class="truncate text-sm font-medium" title="<%= file.originalName %>"><%= file.originalName %></div><div class="text-xs text-faint d:hidden"><%= fmt(file.fileSize) %> · <%= new Date(file.uploadedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></div></div>
      </div>
      <span class="hidden text-sm text-muted d:block"><%= fmt(file.fileSize) %></span>
      <span class="hidden text-sm text-muted d:block"><%= new Date(file.uploadedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
      <div class="flex items-center justify-end gap-0.5">
        <button type="button" class="file-action-btn icon-btn hidden d:inline-flex" data-action="details" data-file-id="<%= file._id %>" data-file-name="<%= file.originalName %>" data-file-size="<%= file.fileSize %>" data-upload-date="<%= new Date(file.uploadedAt).toISOString() %>" aria-label="Details for <%= file.originalName %>" title="Details"><%- include('../partials/icon', {n:'info'}) %></button>
        <a href="/files/<%= file._id %>" class="icon-btn" aria-label="Download <%= file.originalName %>" title="Download"><%- include('../partials/icon', {n:'download'}) %></a>
        <button type="button" class="file-action-btn icon-btn" data-action="share" data-file-id="<%= file._id %>" aria-label="Share <%= file.originalName %>" title="Share"><%- include('../partials/icon', {n:'share'}) %></button>
        <button type="button" class="file-action-btn icon-btn hidden d:inline-flex" data-action="rename" data-file-id="<%= file._id %>" data-file-name="<%= file.originalName %>" aria-label="Rename <%= file.originalName %>" title="Rename"><%- include('../partials/icon', {n:'edit'}) %></button>
        <button type="button" class="file-action-btn icon-btn hover:!text-rust" data-action="delete" data-file-id="<%= file._id %>" aria-label="Delete <%= file.originalName %>" title="Delete"><%- include('../partials/icon', {n:'trash'}) %></button>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <button type="button" data-open-upload class="mt-4 flex w-full cursor-pointer flex-col items-center justify-center gap-3 rounded-[18px] border-[1.5px] border-dashed border-[#cfd5cd] bg-[#f7f9f6] px-6 py-12 text-center transition hover:border-ink">
    <span class="inline-flex size-12 items-center justify-center rounded-2xl bg-white text-forest shadow-sm"><%- include('../partials/icon', {n:'upload', s:22}) %></span>
    <span class="font-medium">No files yet</span>
    <span class="text-sm text-muted">Upload your first file to get started.</span>
  </button>
  <% } %>
</section>

<section class="mt-10" aria-labelledby="sharedTitle">
  <h2 id="sharedTitle" class="m-0 text-lg font-semibold">Shared with you</h2>
  <% if (shared.length) { %>
  <div class="mt-4 grid grid-cols-1 gap-3 d:grid-cols-2">
    <% shared.forEach(function (file) { %>
    <div class="flex items-center gap-3 rounded-2xl border border-line-soft bg-white p-3.5" data-name="<%= file.originalName %>">
      <%- include('../partials/file-badge', { name: file.originalName, mime: file.mimeType }) %>
      <div class="min-w-0 flex-1">
        <div class="truncate text-sm font-medium" title="<%= file.originalName %>"><%= file.originalName %></div>
        <div class="truncate text-xs text-faint">from <%= file.userId && (file.userId.firstName || file.userId.lastName) ? ((file.userId.firstName || '') + ' ' + (file.userId.lastName || '')).trim() : ((file.userId && file.userId.username) || 'Owner') %> · <%= new Date(file.uploadedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></div>
      </div>
      <a href="/files/<%= file._id %>" class="icon-btn" aria-label="Download <%= file.originalName %>"><%- include('../partials/icon', {n:'download'}) %></a>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <p class="mt-3 text-sm text-muted">Files other people share with your username will appear here.</p>
  <% } %>
</section>

<%- include('../partials/file-modals') %>
<script src="/js/file-operations.js"></script>
<script src="/js/file-actions.js"></script>
<script src="/js/file-page-events.js"></script>
