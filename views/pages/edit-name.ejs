<% layout('layouts/app') %>
<% block('nav', 'profile') %>

<nav class="in text-sm text-faint" style="--d:.05s" aria-label="Breadcrumb"><a href="/profile" class="text-faint no-underline hover:text-ink">Profile</a> <span aria-hidden="true">/</span> <span class="text-ink">Edit name</span></nav>
<h1 class="serif in mt-2 mb-0 text-[44px] leading-none d:text-[64px]" style="--d:.1s">Edit <i>name</i></h1>

<form method="POST" action="/profile/edit-name" class="card in mt-8 grid max-w-[620px] gap-5 p-6 d:p-8" style="--d:.15s">
  <div class="grid grid-cols-1 gap-4 d:grid-cols-2">
    <div><label for="firstName" class="field-label">First name</label><input id="firstName" type="text" name="firstName" class="field" value="<%= (user && user.firstName) || '' %>" required maxlength="50" pattern="[A-Za-z\s'.\-]+" autocomplete="given-name"></div>
    <div><label for="lastName" class="field-label">Last name</label><input id="lastName" type="text" name="lastName" class="field" value="<%= (user && user.lastName) || '' %>" required maxlength="50" pattern="[A-Za-z\s'.\-]+" autocomplete="family-name"></div>
  </div>
  <div class="flex flex-wrap gap-3"><button type="submit" class="btn btn-dark h-11">Save changes</button><a href="/profile" class="btn btn-light h-11">Cancel</a></div>
</form>
