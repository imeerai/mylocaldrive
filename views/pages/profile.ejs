<% layout('layouts/app') %>
<% block('nav', 'profile') %>
<%
  const full = [user.firstName, user.lastName].filter(Boolean).join(' ').trim();
  const initials = (full ? full.split(/\s+/).map(p => p[0]).join('') : (user.username || 'U')).slice(0, 2).toUpperCase();
  const bytes = typeof storageBytes !== 'undefined' ? Number(storageBytes) || 0 : 0;
  const usedMB = bytes / 1048576;
  const pct = Math.min(100, (usedMB / 500) * 100);
  const since = new Date(user.createdAt || Date.now()).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
%>

<section class="in flex flex-col gap-5 d:flex-row d:items-center" style="--d:.05s">
  <span class="inline-flex size-20 shrink-0 items-center justify-center rounded-full bg-sage font-serif text-[34px] text-forest-deep d:size-24 d:text-[40px]"><%= initials %></span>
  <div class="min-w-0">
    <h1 class="serif m-0 truncate text-[44px] leading-none d:text-[60px]"><%= full || user.username %></h1>
    <p class="mt-2 mb-0 text-muted">@<%= user.username %> · <%= user.email %> · Member since <%= since %></p>
  </div>
</section>


<div class="mt-8 grid grid-cols-1 gap-4 d:grid-cols-2">
  <section class="card in p-6 d:p-7" style="--d:.1s" aria-labelledby="nameTitle">
    <h2 id="nameTitle" class="m-0 text-lg font-semibold">Your name</h2>
    <p class="mt-1 mb-5 text-sm text-muted">Shown on your dashboard and to people you share with.</p>
    <form method="POST" action="/profile/edit-name" class="grid gap-4">
      <div class="grid grid-cols-1 gap-4 d:grid-cols-2">
        <div><label for="firstName" class="field-label">First name</label><input id="firstName" type="text" name="firstName" class="field" value="<%= user.firstName || '' %>" required maxlength="50" pattern="[A-Za-z\s'.\-]+" autocomplete="given-name"></div>
        <div><label for="lastName" class="field-label">Last name</label><input id="lastName" type="text" name="lastName" class="field" value="<%= user.lastName || '' %>" required maxlength="50" pattern="[A-Za-z\s'.\-]+" autocomplete="family-name"></div>
      </div>
      <div><button type="submit" class="btn btn-dark btn-sm h-11">Save name</button></div>
    </form>
  </section>

  <section class="card in p-6 d:p-7" style="--d:.15s" aria-labelledby="storageTitle">
    <h2 id="storageTitle" class="m-0 text-lg font-semibold">Storage</h2>
    <div class="mt-5 flex items-center gap-6">
      <svg width="110" height="110" viewBox="0 0 120 120" class="shrink-0" aria-hidden="true"><circle cx="60" cy="60" r="48" fill="none" stroke="#eef0ec" stroke-width="12"/><circle cx="60" cy="60" r="48" fill="none" stroke="#3f7d5a" stroke-width="12" stroke-linecap="round" stroke-dasharray="302" stroke-dashoffset="<%= (302 - (302 * pct) / 100).toFixed(1) %>" transform="rotate(-90 60 60)"/><text x="60" y="68" text-anchor="middle" font-family="Instrument Serif, serif" font-size="28" fill="#171b18"><%= Math.round(pct) %>%</text></svg>
      <div>
        <div class="text-[28px] font-semibold tracking-[-.5px]"><%= usedMB.toFixed(1) %> <span class="text-sm font-medium text-faint">of 500 MB</span></div>
        <div class="mt-1 text-sm text-muted"><%= typeof fileCount !== 'undefined' ? fileCount : 0 %> files stored · <%= Math.max(0, 500 - usedMB).toFixed(1) %> MB free</div>
        <a href="/files" class="mt-3 inline-block text-sm text-ink underline decoration-line underline-offset-4 hover:decoration-ink">Manage files</a>
      </div>
    </div>
  </section>

  <section class="card in p-6 d:p-7" style="--d:.2s" aria-labelledby="secTitle">
    <h2 id="secTitle" class="m-0 text-lg font-semibold">Security</h2>
    <div class="mt-4 grid gap-2">
      <a href="/profile/change-password" class="flex items-center gap-3.5 rounded-2xl bg-mist px-4 py-3.5 text-ink no-underline transition hover:-translate-y-0.5"><span class="inline-flex size-9 items-center justify-center rounded-xl bg-white text-forest-deep"><%- include('../partials/icon', {n:'lock', s:17}) %></span><span class="flex-1"><span class="block text-[15px] font-medium">Change password</span><span class="block text-sm text-muted">Use upper and lower case letters and a number.</span></span><%- include('../partials/icon', {n:'arrow', s:16}) %></a>
      <a href="/user/logout" data-logout class="flex items-center gap-3.5 rounded-2xl px-4 py-3.5 text-ink no-underline transition hover:bg-mist"><span class="inline-flex size-9 items-center justify-center rounded-xl bg-[#f2f4f1]"><%- include('../partials/icon', {n:'logout', s:17}) %></span><span class="flex-1"><span class="block text-[15px] font-medium">Sign out</span><span class="block text-sm text-muted">End this session on this device.</span></span></a>
    </div>
  </section>

  <section class="card in border-rust/25 p-6 d:p-7" style="--d:.25s" aria-labelledby="dangerTitle">
    <h2 id="dangerTitle" class="m-0 text-lg font-semibold text-rust">Delete account</h2>
    <p class="mt-1 mb-5 text-sm leading-relaxed text-muted">Removes your account and every file you stored. This cannot be undone.</p>
    <button type="button" id="deleteAccountBtn" class="btn btn-danger btn-sm h-11"><%- include('../partials/icon', {n:'trash', s:15}) %>Delete my account</button>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('deleteAccountBtn');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const ok = await showConfirm('Delete your account? All your files and account data will be removed. This cannot be undone.');
      if (!ok) return;
      try {
        const res = await fetch('/profile/delete-account', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
        const data = await res.json();
        if (data.success) {
          try { localStorage.setItem('mydrive-auth-state', JSON.stringify({ loggedIn: false, ts: Date.now() })); } catch (e) {}
          showSuccess('Account deleted. Redirecting…');
          setTimeout(() => { window.location.href = '/user/logout'; }, 1500);
        } else {
          showError(data.error || 'Failed to delete account');
        }
      } catch (err) {
        showError('Failed to delete account');
      }
    });
  });
</script>
