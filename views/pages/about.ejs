<% layout('layouts/main') %>

<section class="relative overflow-clip">
  <div class="sky absolute inset-0" aria-hidden="true"></div>
  <div class="cloud top-[280px] left-[6%] h-[110px] w-[460px] opacity-90" aria-hidden="true"></div>
  <div class="cloud top-[250px] right-[3%] h-[100px] w-[420px] opacity-80 [animation-duration:30s]" aria-hidden="true"></div>
  <%- include('../partials/header', { currentPage: 'about' }) %>
  <div class="relative px-5 pt-14 pb-28 text-center d:px-10 d:pt-[72px] d:pb-[150px]">
    <span class="pill in" style="--d:.1s">About</span>
    <h1 class="serif in mx-auto mt-7 max-w-[900px] text-[54px] leading-[.98] d:text-[96px]" style="--d:.2s">A quieter place to <i>keep</i> things</h1>
    <p class="in mx-auto mt-6 max-w-[540px] text-[17px] leading-relaxed text-muted d:text-[19px]" style="--d:.35s">MyDrive started as a simple question: why does storing a file have to feel so busy?</p>
  </div>
</section>

<section class="flex justify-center px-5 py-20 d:px-16 d:py-[120px]">
  <p class="serif m-0 max-w-[1050px] text-center text-[34px] leading-[1.15] d:text-[54px]">
    <% 'Most drives want your attention. MyDrive wants your files to be *safe*, *findable* and *yours*, and then to get out of the way.'.split(' ').forEach(function (w) { %><span class="w"><% if (w.startsWith('*')) { %><i><%= w.replace(/\*/g, '') %></i><% } else { %><%= w %><% } %></span> <% }) %>
  </p>
</section>

<section class="grid grid-cols-1 gap-10 px-5 pb-24 d:grid-cols-2 d:gap-20 d:px-16 d:pb-[120px]">
  <h2 class="serif sv m-0 text-[44px] leading-none d:text-[60px]">The <i>story</i></h2>
  <div class="sv grid gap-5 text-[17px] leading-relaxed text-muted">
    <p class="m-0">MyDrive is a personal project: a small, private cloud drive built as a calm alternative to cluttered storage apps. It does the few things you need, upload, organise, share and recover, and tries to do them well.</p>
    <p class="m-0">It is built and maintained by a full-stack developer who cares about clean interfaces and secure defaults. You can see more of that work at <a class="text-ink underline decoration-line underline-offset-4 hover:decoration-ink" href="https://imeer.dev" rel="noopener">imeer.dev</a>.</p>
  </div>
</section>

<section class="px-5 pb-24 d:px-16 d:pb-[120px]">
  <div class="grid grid-cols-1 gap-[18px] d:grid-cols-4">
    <% [['lock','Private by default','Files live in a private bucket. Sharing is always a choice you make.'],['pulse','Fast and simple','A short path from "I need that file" to having it.'],['folder','Honest storage','500 MB, clearly measured. No surprise limits.'],['shield','Open about the stack','The tools behind it are listed right below.']].forEach(function (p) { %>
    <div class="card card-hover sv"><span class="inline-flex size-10 items-center justify-center rounded-xl bg-sage text-forest-deep"><%- include('../partials/icon', {n:p[0], s:18}) %></span><h3 class="mt-5 mb-0 text-lg font-semibold"><%= p[1] %></h3><p class="mt-2 text-[15px] leading-relaxed text-muted"><%= p[2] %></p></div>
    <% }) %>
  </div>
</section>

<section class="px-5 pb-24 d:px-16 d:pb-[120px]">
  <div class="sv rounded-[28px] bg-mist p-7 text-center d:p-14">
    <span class="text-sm text-muted">Under the hood</span>
    <div class="mt-5 flex flex-wrap justify-center gap-2.5">
      <% ['Node.js','Express','EJS','Tailwind CSS','MongoDB','Cloudflare R2','JWT','Helmet'].forEach(function (t) { %><span class="pill bg-white"><%= t %></span><% }) %>
    </div>
  </div>
</section>

<section class="px-5 pb-24 d:px-16 d:pb-[120px]">
  <h2 class="serif sv mb-12 text-[44px] leading-none d:text-[60px]">How it <i>grew</i></h2>
  <div class="grid grid-cols-1 gap-10 d:grid-cols-4">
    <% [['Idea','A drive with fewer buttons and more calm.'],['First upload','Files stored privately, sorted and paged.'],['Sharing','Send to a username or share by link.'],['Redesign','A lighter look, built mobile-first.']].forEach(function (s, i) { %>
    <div class="sv"><div class="flex items-center gap-3"><span class="size-2.5 shrink-0 rounded-full <%= i === 3 ? 'bg-forest' : 'bg-ink' %>"></span><div class="ln h-px flex-1 bg-ink"></div></div><h3 class="serif mt-5 mb-0 text-[32px] leading-none"><%= s[0] %></h3><p class="mt-2 text-[15px] text-muted"><%= s[1] %></p></div>
    <% }) %>
  </div>
</section>

<section class="px-5 pb-24 d:px-10">
  <div class="sky relative min-h-[460px] overflow-hidden rounded-[30px] text-center">
    <div class="rise absolute inset-x-0 bottom-0 h-[320px]" aria-hidden="true"><%- include('../partials/landscape') %></div>
    <div class="sv relative px-6 pt-20">
      <h2 class="serif m-0 text-[46px] leading-none d:text-[72px]">Make some <i>room</i></h2>
      <p class="mt-4 mb-8 text-lg text-muted">Your first 500 MB are on us.</p>
      <a class="btn btn-dark" href="/user/register">Get started</a>
    </div>
  </div>
</section>
