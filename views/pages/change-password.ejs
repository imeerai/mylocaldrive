<% layout('layouts/app') %>
<% block('nav', 'security') %>

<nav class="in text-sm text-faint" style="--d:.05s" aria-label="Breadcrumb"><a href="/profile" class="text-faint no-underline hover:text-ink">Profile</a> <span aria-hidden="true">/</span> <span class="text-ink">Change password</span></nav>
<h1 class="serif in mt-2 mb-0 text-[44px] leading-none d:text-[64px]" style="--d:.1s">Change <i>password</i></h1>
<p class="in mt-3 text-muted" style="--d:.15s">You'll stay signed in on this device.</p>

<div class="mt-8 grid grid-cols-1 items-start gap-4 d:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
  <form id="changePasswordForm" method="POST" action="/profile/change-password" class="card in grid gap-5 p-6 d:p-8" style="--d:.2s" novalidate>
    <div>
      <label for="currentPassword" class="field-label">Current password</label>
      <div class="relative">
        <input type="password" id="currentPassword" name="currentPassword" class="field pr-12" autocomplete="current-password" required>
        <button type="button" class="icon-btn absolute top-1 right-1" data-toggle-password="currentPassword" aria-label="Show password"><%- include('../partials/icon', {n:'eye', s:18}) %></button>
      </div>
      <span class="error-message field-error" id="currentPasswordError"></span>
    </div>
    <div>
      <label for="newPassword" class="field-label">New password</label>
      <div class="relative">
        <input type="password" id="newPassword" name="newPassword" class="field pr-12" autocomplete="new-password" minlength="8" maxlength="128" required>
        <button type="button" class="icon-btn absolute top-1 right-1" data-toggle-password="newPassword" aria-label="Show password"><%- include('../partials/icon', {n:'eye', s:18}) %></button>
      </div>
      <span class="error-message field-error" id="newPasswordError"></span>
      <ul class="mt-3 grid list-none gap-1.5 p-0 text-[13px] text-faint" id="pwRules">
        <li data-rule="len" class="flex items-center gap-2"><span class="rule-dot inline-flex size-4 items-center justify-center rounded-full border border-line"></span>At least 8 characters</li>
        <li data-rule="upper" class="flex items-center gap-2"><span class="rule-dot inline-flex size-4 items-center justify-center rounded-full border border-line"></span>One uppercase letter</li>
        <li data-rule="lower" class="flex items-center gap-2"><span class="rule-dot inline-flex size-4 items-center justify-center rounded-full border border-line"></span>One lowercase letter</li>
        <li data-rule="num" class="flex items-center gap-2"><span class="rule-dot inline-flex size-4 items-center justify-center rounded-full border border-line"></span>One number</li>
      </ul>
    </div>
    <div>
      <label for="confirmPassword" class="field-label">Confirm new password</label>
      <input type="password" id="confirmPassword" name="confirmPassword" class="field" autocomplete="new-password" required>
      <span class="error-message field-error" id="confirmPasswordError"></span>
    </div>
    <div class="flex flex-wrap items-center gap-3 pt-1">
      <button type="submit" class="btn btn-dark h-11">Save password</button>
      <a href="/profile" class="btn btn-light h-11">Cancel</a>
    </div>
  </form>

  <aside class="in grid gap-4" style="--d:.25s">
    <div class="rounded-[22px] bg-mist p-6">
      <h2 class="m-0 text-base font-semibold">A few tips</h2>
      <ul class="mt-3 mb-0 grid list-none gap-2.5 p-0 text-sm text-muted">
        <li class="flex gap-2.5"><span class="mt-0.5 text-forest"><%- include('../partials/icon', {n:'check', s:15, w:2.2}) %></span>Use a phrase only you would think of.</li>
        <li class="flex gap-2.5"><span class="mt-0.5 text-forest"><%- include('../partials/icon', {n:'check', s:15, w:2.2}) %></span>Don't reuse a password from another site.</li>
        <li class="flex gap-2.5"><span class="mt-0.5 text-forest"><%- include('../partials/icon', {n:'check', s:15, w:2.2}) %></span>It can't match your username or email.</li>
      </ul>
    </div>
    <div class="flex items-center gap-3 rounded-[22px] border border-line-soft bg-white p-5 text-sm"><span class="live size-2 rounded-full bg-forest"></span>Signed in as <b class="font-medium"><%= user.username %></b></div>
  </aside>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const cur = document.getElementById('currentPassword');
  const pw = document.getElementById('newPassword');
  const conf = document.getElementById('confirmPassword');
  const curErr = document.getElementById('currentPasswordError');
  const pwErr = document.getElementById('newPasswordError');
  const confErr = document.getElementById('confirmPasswordError');
  const rules = { len: (v) => v.length >= 8, upper: (v) => /[A-Z]/.test(v), lower: (v) => /[a-z]/.test(v), num: (v) => /[0-9]/.test(v) };
  const labels = { len: 'At least 8 characters', upper: '1 uppercase letter', lower: '1 lowercase letter', num: '1 number' };
  const setErr = (input, el, msg) => { el.textContent = msg; input.classList.toggle('input-error', !!msg); };
  const missing = (v) => Object.keys(rules).filter((k) => !rules[k](v));

  pw.addEventListener('input', () => {
    const miss = missing(pw.value);
    document.querySelectorAll('#pwRules [data-rule]').forEach((li) => {
      const ok = !miss.includes(li.dataset.rule) && pw.value;
      li.classList.toggle('text-ink', !!ok);
      const dot = li.querySelector('.rule-dot');
      dot.className = 'rule-dot inline-flex size-4 items-center justify-center rounded-full ' + (ok ? 'bg-forest text-white' : 'border border-line');
      dot.innerHTML = ok ? '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>' : '';
    });
    setErr(pw, pwErr, '');
    if (conf.value) conf.dispatchEvent(new Event('input'));
  });
  conf.addEventListener('input', () => setErr(conf, confErr, conf.value !== pw.value ? 'Passwords do not match' : ''));

  document.getElementById('changePasswordForm').addEventListener('submit', (e) => {
    let ok = true;
    if (!cur.value) { setErr(cur, curErr, 'Current password is required'); ok = false; } else setErr(cur, curErr, '');
    const miss = missing(pw.value);
    if (miss.length) { setErr(pw, pwErr, 'Missing: ' + miss.map((k) => labels[k]).join(', ')); ok = false; }
    if (pw.value !== conf.value) { setErr(conf, confErr, 'Passwords do not match'); ok = false; }
    if (!ok) e.preventDefault();
  });

});
</script>
