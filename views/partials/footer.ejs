<footer class="overflow-x-clip border-t border-line bg-panel px-5 pt-14 text-ink d:px-16 d:pt-[72px]">
  <div class="grid grid-cols-2 gap-10 d:grid-cols-[2fr_1fr_1fr_1fr]">
    <div class="col-span-2 d:col-span-1">
      <%- include('logo') %>
      <p class="mt-4 max-w-[300px] text-[15px] leading-relaxed text-muted">A calm home for your files. Upload, organise and share without the clutter.</p>
    </div>
    <div class="flex flex-col gap-3 text-[15px]">
      <span class="text-[13px] font-semibold">Product</span>
      <a class="text-muted no-underline hover:text-ink" href="/features">Features</a>
      <a class="text-muted no-underline hover:text-ink" href="/user/register">Create account</a>
      <a class="text-muted no-underline hover:text-ink" href="/user/login">Sign in</a>
    </div>
    <div class="flex flex-col gap-3 text-[15px]">
      <span class="text-[13px] font-semibold">Company</span>
      <a class="text-muted no-underline hover:text-ink" href="/about">About</a>
      <a class="text-muted no-underline hover:text-ink" href="/contact">Contact</a>
    </div>
    <div class="flex flex-col gap-3 text-[15px]">
      <span class="text-[13px] font-semibold">Status</span>
      <span class="inline-flex items-center gap-2 text-muted"><span class="live size-[7px] rounded-full bg-forest"></span>All systems normal</span>
    </div>
  </div>
  <div class="ft-word serif mt-10 text-center text-[30vw] leading-[1.12] tracking-[-.04em] whitespace-nowrap d:text-[330px]" aria-hidden="true">My<i>Drive</i></div>
  <div class="flex flex-wrap justify-between gap-2.5 border-t border-line pt-5 pb-7 text-[13px] text-faint">
    <span>&copy; <%= new Date().getFullYear() %> MyDrive</span>
    <span>Built by <a class="text-muted no-underline hover:text-ink" href="https://imeer.dev" rel="noopener">imeer.dev</a></span>
  </div>
</footer>
