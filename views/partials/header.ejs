<% const _li = typeof isLoggedIn !== 'undefined' && isLoggedIn; const _cp = typeof currentPage !== 'undefined' ? currentPage : ''; %>
<header class="in relative z-40 font-sans text-ink">
  <nav class="navbar relative flex h-[84px] items-center justify-between gap-6 px-5 d:px-16" aria-label="Main">
    <%- include('logo') %>
    <div class="flex items-center gap-1.5">
      <div class="mr-3.5 hidden items-center gap-0.5 d:flex">
        <a class="nav-link <%= _cp === 'home' ? 'text-ink' : '' %>" href="/">Home</a>
        <a class="nav-link <%= _cp === 'features' ? 'text-ink' : '' %>" href="/features">Features</a>
        <a class="nav-link <%= _cp === 'about' ? 'text-ink' : '' %>" href="/about">About</a>
        <a class="nav-link <%= _cp === 'contact' ? 'text-ink' : '' %>" href="/contact">Contact</a>
        <% if (!_li) { %><a class="nav-link" href="/user/login">Sign in</a><% } %>
      </div>
      <% if (_li) { %>
        <a class="btn btn-dark btn-sm d:h-11 d:px-[22px] d:text-[15px]" href="/dashboard">Open dashboard</a>
      <% } else { %>
        <a class="btn btn-dark btn-sm d:h-11 d:px-[22px] d:text-[15px]" href="/user/register">Get started</a>
      <% } %>
      <button id="mobileMenuToggle" type="button" class="inline-flex size-11 items-center justify-center rounded-full border border-[#dfe3dd] bg-white d:hidden" aria-label="Open menu" aria-controls="navMenu">
        <%- include('icon', {n:'menu', s:18}) %>
      </button>
    </div>
    <div id="navMenu" class="absolute top-[74px] right-5 z-50 hidden w-60 flex-col rounded-[18px] border border-line bg-white p-2 shadow-[0_24px_50px_-24px_rgba(23,27,24,.35)] d:!hidden">
      <a class="nav-link rounded-xl py-3 text-base" href="/">Home</a>
      <a class="nav-link rounded-xl py-3 text-base" href="/features">Features</a>
      <a class="nav-link rounded-xl py-3 text-base" href="/about">About</a>
      <a class="nav-link rounded-xl py-3 text-base" href="/contact">Contact</a>
      <% if (_li) { %>
        <a class="nav-link rounded-xl py-3 text-base" href="/dashboard">Dashboard</a>
        <a class="nav-link rounded-xl py-3 text-base" href="/user/logout" data-logout>Sign out</a>
      <% } else { %>
        <a class="nav-link rounded-xl py-3 text-base" href="/user/login">Sign in</a>
      <% } %>
    </div>
  </nav>
</header>
