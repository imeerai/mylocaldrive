<!-- Shared modals for file operations (Dashboard & Files page). IDs and data-* hooks are used by file-operations.js / file-actions.js. -->

<!-- Rename -->
<div id="renameModal" class="modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="renameTitle">
  <div class="modal-panel">
    <h2 id="renameTitle" class="serif m-0 text-[34px] leading-none">Rename <i>file</i></h2>
    <p class="mt-2 mb-5 text-sm text-muted">The extension stays the same.</p>
    <input type="hidden" id="renameFileId">
    <input type="hidden" id="renameOriginalExt">
    <label for="newFileName" class="field-label">New name</label>
    <input type="text" id="newFileName" class="field" placeholder="Enter a new file name">
    <div class="mt-6 flex flex-wrap justify-end gap-2.5">
      <button type="button" class="btn btn-light btn-sm modal-close-btn" data-modal="renameModal">Cancel</button>
      <button type="button" class="btn btn-dark btn-sm modal-action-btn" data-action="confirmRename">Rename</button>
    </div>
  </div>
</div>

<!-- Details -->
<div id="fileDetailsModal" class="modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="detailsTitle">
  <div class="modal-panel max-w-[500px]">
    <div class="flex items-center justify-between">
      <h2 id="detailsTitle" class="serif m-0 text-[34px] leading-none">File <i>details</i></h2>
      <button type="button" class="icon-btn modal-close-btn" data-modal="fileDetailsModal" aria-label="Close"><%- include('icon', {n:'close', s:18}) %></button>
    </div>
    <dl class="mt-6 grid gap-0 overflow-hidden rounded-2xl border border-line-soft text-sm">
      <div class="grid gap-1 px-4 py-3"><dt class="text-faint">File name</dt><dd id="detailFileName" class="m-0 font-medium break-all"></dd></div>
      <div class="grid gap-1 border-t border-line-soft px-4 py-3"><dt class="text-faint">Size</dt><dd id="detailFileSize" class="m-0"></dd></div>
      <div class="grid gap-1 border-t border-line-soft px-4 py-3"><dt class="text-faint">Uploaded</dt><dd id="detailUploadDate" class="m-0"></dd></div>
      <div class="grid gap-1 border-t border-line-soft px-4 py-3"><dt class="text-faint">Tags</dt><dd id="detailTags" class="m-0 flex min-h-6 flex-wrap gap-2"><span class="text-faint">No tags yet</span></dd></div>
    </dl>
    <div class="mt-6 flex justify-end">
      <button type="button" class="btn btn-light btn-sm modal-close-btn" data-modal="fileDetailsModal">Close</button>
    </div>
  </div>
</div>

<!-- Share -->
<div id="shareModal" class="modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="shareTitle">
  <div class="modal-panel max-w-[480px]">
    <h2 id="shareTitle" class="serif m-0 text-[34px] leading-none">Share <i>file</i></h2>
    <p class="mt-2 mb-5 text-sm text-muted">Send it to another MyDrive user, or copy a link.</p>
    <input type="hidden" id="shareFileId">
    <label for="shareUsername" class="field-label">Share with user</label>
    <input type="text" id="shareUsername" class="field" placeholder="Recipient's username" autocomplete="off">
    <div class="mt-5 rounded-2xl bg-mist p-4">
      <label for="shareLink" class="field-label flex items-center gap-2"><%- include('icon', {n:'link', s:15}) %>Share link</label>
      <div class="flex gap-2">
        <input type="text" id="shareLink" class="field h-11 min-w-0 flex-1 text-[13px]" placeholder="Generating link…" readonly>
        <button type="button" class="modal-action-btn btn btn-dark btn-sm h-11 shrink-0" data-action="copyShareLink" id="copyLinkBtn">Copy</button>
      </div>
      <p class="mt-2.5 mb-0 text-xs text-muted">Anyone with this link can view the file.</p>
    </div>
    <div class="mt-6 flex flex-wrap justify-end gap-2.5">
      <button type="button" class="btn btn-light btn-sm modal-close-btn" data-modal="shareModal">Cancel</button>
      <button type="button" class="btn btn-dark btn-sm modal-action-btn" data-action="confirmShare">Share</button>
    </div>
  </div>
</div>

<!-- Upload -->
<div id="uploadModal" class="modal z-[1000]" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="uploadTitle">
  <div class="modal-panel flex max-h-[90vh] max-w-[560px] flex-col">
    <div class="flex items-center justify-between">
      <h2 id="uploadTitle" class="serif m-0 text-[34px] leading-none">Upload <i>files</i></h2>
      <button type="button" id="uploadModalCloseBtn" class="icon-btn" aria-label="Close"><%- include('icon', {n:'close', s:18}) %></button>
    </div>
    <div class="mt-5 overflow-y-auto">
      <div id="dropZone" class="cursor-pointer rounded-2xl border-[1.5px] border-dashed border-[#cfd5cd] bg-[#f7f9f6] px-6 py-9 text-center transition">
        <span class="mx-auto mb-3 inline-flex size-12 items-center justify-center rounded-2xl bg-white text-forest shadow-sm"><%- include('icon', {n:'upload', s:22}) %></span>
        <p class="m-0 font-medium">Drag files here or click to choose</p>
        <p class="mt-1 mb-0 text-sm text-muted">Up to 10 files at a time</p>
        <input type="file" id="fileInput" multiple style="display: none;">
        <button type="button" id="selectFilesBtn" class="btn btn-light btn-sm mt-5">Choose files</button>
      </div>
      <div id="fileListContainer" class="mt-5" style="display: none;">
        <p class="mb-2 text-sm text-muted">Ready to upload (<span id="fileCount">0</span> files)</p>
        <div id="fileList" class="max-h-[250px] overflow-y-auto rounded-2xl border border-line-soft bg-white"></div>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap justify-end gap-2.5 border-t border-line-soft pt-5">
      <button type="button" id="cancelUploadBtn" class="btn btn-light btn-sm">Cancel</button>
      <button type="button" id="uploadBtn" class="btn btn-dark btn-sm" style="display: none;">Upload</button>
    </div>
  </div>
</div>

<!-- Upload progress panel -->
<div id="uploadProgressPopup" class="fixed bottom-4 left-4 z-[2000] w-[380px] max-w-[calc(100vw-20px)] overflow-hidden rounded-[18px] border border-line bg-white shadow-[0_30px_60px_-28px_rgba(23,40,30,.45)]" style="display: none; transition: transform .25s ease, opacity .25s ease; transform: translateY(120%); opacity: 0;">
  <div class="flex items-center justify-between border-b border-line-soft px-4 py-3">
    <div id="progressTitleBlock" class="flex items-center gap-2.5">
      <span class="live size-2 rounded-full bg-forest"></span>
      <h3 id="progressHeaderTitle" class="m-0 text-[15px] font-semibold">Uploading 0 items</h3>
    </div>
    <div class="flex items-center gap-1">
      <button type="button" id="toggleCollapseBtn" class="modal-action-btn icon-btn size-8" data-action="toggleProgressCollapse" title="Collapse panel" aria-label="Collapse panel"><i class="fas fa-chevron-down"></i></button>
      <button type="button" id="closeProgressBtn" class="modal-action-btn icon-btn size-8" data-action="toggleProgressVisibility" title="Hide panel" aria-label="Hide panel"><i class="fas fa-times"></i></button>
    </div>
  </div>
  <div id="progressPopupContent" class="max-h-[min(58vh,420px)] overflow-y-auto">
    <div class="flex items-center justify-between gap-3 border-b border-line-soft px-4 py-2.5">
      <p id="progressPopupSummary" class="m-0 text-[13px] text-muted">Starting uploads…</p>
      <button type="button" id="cancelAllUploadsBtn" class="modal-action-btn cursor-pointer text-xs font-semibold tracking-wide text-rust" data-action="cancelAllUploads">CANCEL</button>
    </div>
    <div id="uploadFilesList"></div>
  </div>
</div>

<style>
  #uploadProgressPopup { will-change: transform; }
  #reopenUploadPanelBtn { display: none; }
  @media (max-width: 820px) {
    #uploadProgressPopup { left: 8px !important; right: 8px !important; bottom: 92px !important; width: auto !important; max-width: none !important; max-height: 54vh !important; }
    #progressPopupContent { max-height: calc(54vh - 50px) !important; }
    #toggleCollapseBtn { display: none !important; }
    #reopenUploadPanelBtn { bottom: 96px !important; }
  }
</style>

<button type="button" id="reopenUploadPanelBtn" class="modal-action-btn fixed bottom-4 left-4 z-[2100] h-10 items-center gap-2 rounded-full bg-ink px-4 text-[13px] font-medium text-white shadow-lg" data-action="showProgressPanel" style="display: none;">
  <%- include('icon', {n:'upload', s:15, w:2}) %> Uploads
</button>

<!-- Confirm -->
<div id="confirmModal" class="modal z-[1100]" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
  <div class="modal-panel max-w-[420px]">
    <h3 id="confirmTitle" class="serif m-0 text-[30px] leading-none">Please <i>confirm</i></h3>
    <p id="confirmMessage" class="mt-3 mb-6 leading-relaxed text-muted"></p>
    <div class="flex flex-wrap justify-end gap-2.5">
      <button type="button" id="confirmCancel" class="btn btn-light btn-sm">Cancel</button>
      <button type="button" id="confirmOk" class="btn btn-dark btn-sm">Yes, proceed</button>
    </div>
  </div>
</div>
